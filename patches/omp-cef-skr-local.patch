diff --git a/src/client/core/skr_local_api.cpp b/src/client/core/skr_local_api.cpp
new file mode 100644
index 0000000..de18595
--- /dev/null
+++ b/src/client/core/skr_local_api.cpp
@@ -0,0 +1,373 @@
+// SKR Local Browser API — omp-cef patch
+// Exposes BrowserManager functionality to SKR.Client.dll via C exports.
+//
+// main.cpp supplies the runtime singleton in this local patch.
+
+#define SKR_LOCAL_API_EXPORTS
+#include "skr_local_api.h"
+
+#include "runtime.hpp"
+#include "browser/manager.hpp"
+#include "rendering/render_manager.hpp"
+#include "system/gta.hpp"
+#include "system/logger.hpp"
+
+#include <include/wrapper/cef_helpers.h>
+#include <include/cef_values.h>
+#include <include/cef_task.h>
+#include <include/cef_parser.h>
+#include <algorithm>
+#include <include/base/cef_callback.h>
+#include <include/wrapper/cef_closure_task.h>
+
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+// ── Access to Runtime singleton ───────────────────────────────────────────
+// main.cpp owns the runtime; this extern links to it once `static` is removed.
+extern std::unique_ptr<Runtime> runtime;
+
+static BrowserManager* GetBrowser()
+{
+    if (!runtime) return nullptr;
+    return runtime->GetBrowserManager();
+}
+
+// ── Local event system ────────────────────────────────────────────────────
+// Matches samp-cef's callback signature: int __cdecl(const char* event, void* args)
+using SkrEventCb = int(__cdecl*)(const char*, void*);
+
+static std::mutex g_eventMtx;
+static std::unordered_map<std::string, std::vector<SkrEventCb>> g_eventHandlers;
+static std::unordered_map<int, std::string> g_localPages;
+
+static std::string LocalPageUrl(const std::string& url) {
+    return CefURIDecode(url, true, static_cast<cef_uri_unescape_rule_t>(UU_NORMAL | UU_SPACES)).ToString();
+}
+
+// ── C API implementation ──────────────────────────────────────────────────
+
+SKR_API bool skr_cef_ready()
+{
+    auto* bm = GetBrowser();
+    return bm && bm->IsInitialized();
+}
+
+SKR_API void skr_cef_create_browser(uint32_t id, const char* url, bool hidden, bool focused)
+{
+    auto* bm = GetBrowser();
+    if (!bm || !url) return;
+
+    {
+        std::lock_guard<std::mutex> lock(g_eventMtx);
+        // Only the native-created local lobby may invoke SKR handlers.
+        if (id == 100 && std::string(url).rfind("file:///", 0) == 0)
+            g_localPages[static_cast<int>(id)] = LocalPageUrl(url);
+    }
+
+    // RenderManager may not have captured the device yet (it falls back to
+    // 1280x720), so size the page to the game window explicitly.
+    float width = 0.f, height = 0.f;
+    HWND hwnd = runtime && runtime->GetGta() ? runtime->GetGta()->GetHwnd() : nullptr;
+    RECT rc{};
+    if (hwnd && ::GetClientRect(hwnd, &rc) && rc.right > 0 && rc.bottom > 0)
+    {
+        width = static_cast<float>(rc.right);
+        height = static_cast<float>(rc.bottom);
+    }
+    LOG_INFO("[SKR] create_browser id={} size={}x{}", id, width, height);
+    bm->CreateBrowser(static_cast<int>(id), url, focused, false, width, height);
+    if (!hidden)
+        bm->SetBrowserVisible(static_cast<int>(id), true);
+}
+
+SKR_API void skr_cef_destroy_browser(uint32_t id)
+{
+    auto* bm = GetBrowser();
+    if (!bm) return;
+    {
+        std::lock_guard<std::mutex> lock(g_eventMtx);
+        g_localPages.erase(static_cast<int>(id));
+    }
+    bm->DestroyBrowser(static_cast<int>(id));
+}
+
+SKR_API void skr_cef_hide_browser(uint32_t id, bool hide)
+{
+    auto* bm = GetBrowser();
+    if (!bm) return;
+    bm->SetBrowserVisible(static_cast<int>(id), !hide);
+}
+
+SKR_API void skr_cef_focus_browser(uint32_t id, bool focus)
+{
+    auto* bm = GetBrowser();
+    if (!bm) return;
+    bm->FocusBrowser(static_cast<int>(id), focus);
+}
+
+SKR_API bool skr_cef_browser_exists(uint32_t id)
+{
+    auto* bm = GetBrowser();
+    if (!bm) return false;
+    return bm->GetBrowserInstance(static_cast<int>(id)) != nullptr;
+}
+
+SKR_API bool skr_cef_browser_ready(uint32_t id)
+{
+    auto* bm = GetBrowser();
+    if (!bm) return false;
+    auto* inst = bm->GetBrowserInstance(static_cast<int>(id));
+    return inst && inst->browser && inst->browser->IsValid();
+}
+
+SKR_API bool skr_cef_try_focus_browser(uint32_t id)
+{
+    auto* bm = GetBrowser();
+    if (!bm) return false;
+    auto* inst = bm->GetBrowserInstance(static_cast<int>(id));
+    if (!inst) return false;
+    bm->FocusBrowser(static_cast<int>(id), true);
+    return true;
+}
+
+SKR_API bool skr_cef_input_available(uint32_t id)
+{
+    auto* bm = GetBrowser();
+    if (!bm) return false;
+    auto* inst = bm->GetBrowserInstance(static_cast<int>(id));
+    return inst && inst->visible && inst->view.IsFocused();
+}
+
+SKR_API bool skr_cef_foreign_browser_focused(uint32_t ownId)
+{
+    auto* bm = GetBrowser();
+    if (!bm) return false;
+    for (const auto& [id, inst] : bm->GetBrowsersMap())
+    {
+        if (inst && id != static_cast<int>(ownId) && inst->visible && inst->view.IsFocused())
+            return true;
+    }
+    return false;
+}
+
+SKR_API bool skr_cef_gta_window_active()
+{
+    if (!runtime) return false;
+    HWND hwnd = runtime->GetGta() ? runtime->GetGta()->GetHwnd() : nullptr;
+    return hwnd && ::IsWindow(hwnd) && ::GetForegroundWindow() == hwnd;
+}
+
+static void EmitToAllBrowsers(const char* event, const char* arg)
+{
+    if (!event) return;
+    if (!CefCurrentlyOn(TID_UI)) {
+        const std::string name(event);
+        const bool hasArg = arg != nullptr;
+        const std::string data = hasArg ? arg : "";
+        CefPostTask(TID_UI, base::BindOnce([](std::string name, std::string data, bool hasArg) {
+            EmitToAllBrowsers(name.c_str(), hasArg ? data.c_str() : nullptr);
+        }, name, data, hasArg));
+        return;
+    }
+    auto* bm = GetBrowser();
+    if (!bm) return;
+
+    std::unordered_map<int, std::string> pages;
+    {
+        std::lock_guard<std::mutex> lock(g_eventMtx);
+        pages = g_localPages;
+    }
+    // Same message the renderer's cef.on() listens for (see renderer/main.cpp).
+    for (const auto& [id, inst] : bm->GetBrowsersMap())
+    {
+        if (!inst || !inst->browser || !inst->browser->IsValid())
+            continue;
+        CefRefPtr<CefFrame> frame = inst->browser->GetMainFrame();
+        if (!frame || !frame->IsValid())
+            continue;
+        auto page = pages.find(id);
+        if (page == pages.end() || LocalPageUrl(frame->GetURL().ToString()) != page->second)
+            continue;
+        CefRefPtr<CefProcessMessage> msg = CefProcessMessage::Create("emit_event");
+        msg->GetArgumentList()->SetString(0, event);
+        if (arg)
+            msg->GetArgumentList()->SetString(1, CefString(std::string(arg)));
+        frame->SendProcessMessage(PID_RENDERER, msg);
+    }
+    LOG_DEBUG("[SKR] emit_event -> JS: {} (arg: {})", event, arg ? "string" : "none");
+}
+
+// ── Resource download progress → SKR lobby ─────────────────────────────────
+static std::atomic<bool> g_downloadActive{ false };
+
+bool SkrLobbyPageActive()
+{
+    std::lock_guard<std::mutex> lock(g_eventMtx);
+    return !g_localPages.empty();
+}
+
+void SkrNotifyDownload(const char* state, uint64_t received, uint64_t total, size_t files)
+{
+    const std::string s = state ? state : "";
+    g_downloadActive.store(s == "start" || s == "progress");
+    char json[192];
+    snprintf(json, sizeof(json), "{\"state\":\"%s\",\"received\":%llu,\"total\":%llu,\"files\":%u}",
+             s.c_str(), static_cast<unsigned long long>(received),
+             static_cast<unsigned long long>(total), static_cast<unsigned>(files));
+    EmitToAllBrowsers("skr:lobby:connect:download", json);
+}
+
+SKR_API bool skr_cef_resources_pending()
+{
+    return g_downloadActive.load();
+}
+
+SKR_API void skr_cef_emit_event(const char* event, void* /*args*/)
+{
+    EmitToAllBrowsers(event, nullptr);
+}
+
+SKR_API void skr_cef_emit_event_str(const char* event, const char* arg)
+{
+    EmitToAllBrowsers(event, arg);
+}
+
+bool SkrDispatchLocalEvent(int browserId, const std::string& frameUrl, const std::string& name, const std::string* payload)
+{
+    std::vector<SkrEventCb> handlers;
+    {
+        std::lock_guard<std::mutex> lk(g_eventMtx);
+        auto page = g_localPages.find(browserId);
+        if (page == g_localPages.end() || LocalPageUrl(frameUrl) != page->second)
+            return false;
+        if (payload && payload->size() > 4096) return false;
+        auto it = g_eventHandlers.find(name);
+        if (it == g_eventHandlers.end() || it->second.empty())
+            return false;
+        handlers = it->second;
+    }
+
+    // Called on the CEF UI thread; SKR handlers expect the game thread.
+    // The payload is copied so it outlives this call.
+    const bool hasPayload = payload != nullptr;
+    std::string data = hasPayload ? *payload : std::string();
+    auto run = [name, handlers, hasPayload, data]() {
+        for (auto cb : handlers)
+            cb(name.c_str(), hasPayload ? const_cast<char*>(data.c_str()) : nullptr);
+    };
+    Gta* gta = runtime ? runtime->GetGta() : nullptr;
+    if (!gta) return false;
+    gta->PostToMainThread(run);
+    LOG_INFO("[SKR] JS event dispatched to SKR: {}", name);
+    return true;
+}
+
+SKR_API void skr_cef_subscribe(const char* event, void* callback)
+{
+    if (!event || !callback) return;
+    std::lock_guard<std::mutex> lk(g_eventMtx);
+    auto& callbacks = g_eventHandlers[event];
+    auto cb = reinterpret_cast<SkrEventCb>(callback);
+    if (std::find(callbacks.begin(), callbacks.end(), cb) == callbacks.end())
+        callbacks.push_back(cb);
+    LOG_DEBUG("[SKR] subscribe: {}", event);
+}
+
+SKR_API void* skr_cef_create_list()
+{
+    // CefListValue::Create returns a ref-counted object.
+    // For the local API we return nullptr; the lobby doesn't need
+    // CefListValue readers yet (Phase 2 scope).
+    return nullptr;
+}
+
+SKR_API void skr_cef_on_browser_ready(uint32_t /*id*/, void* /*callback*/)
+{
+    // Stub — browser readiness is polled via skr_cef_browser_ready.
+}
+
+SKR_API void skr_cef_pump_render()
+{
+    auto& rm = RenderManager::Instance();
+
+    if (!rm.GetDevice())
+        rm.PollD3D();
+
+    if (rm.OnPresent)
+        rm.OnPresent();
+
+    static bool loggedOnce = false;
+    if (!loggedOnce) {
+        loggedOnce = true;
+        auto* bm = GetBrowser();
+        LOG_INFO("[SKR_PUMP] First pump: device={}, browserMgr={}, force_draw={}",
+                 (void*)rm.GetDevice(), (void*)bm,
+                 runtime ? runtime->IsForceDrawEnabled() : false);
+    }
+}
+
+static void ApplyZoomOnUiThread(int id, double level)
+{
+    auto* bm = GetBrowser();
+    auto* inst = bm ? bm->GetBrowserInstance(id) : nullptr;
+    if (!inst || !inst->browser || !inst->browser->IsValid())
+        return;
+    auto host = inst->browser->GetHost();
+    if (host && std::abs(host->GetZoomLevel() - level) > 0.01)
+    {
+        host->SetZoomLevel(level);
+        LOG_INFO("[SKR] browser {} zoom level set to {:.3f}", id, level);
+    }
+}
+
+// factor 1.0 = 100%. Chromium may reset zoom on navigation, so callers re-apply it periodically.
+SKR_API void skr_cef_set_zoom(uint32_t id, double factor)
+{
+    if (!std::isfinite(factor) || factor <= 0.0) return;
+    const double level = std::log(factor) / std::log(1.2);
+    CefPostTask(TID_UI, base::BindOnce(&ApplyZoomOnUiThread, static_cast<int>(id), level));
+}
+
+SKR_API void skr_cef_set_force_draw(bool enabled)
+{
+    if (runtime)
+        runtime->SetForceDrawEnabled(enabled);
+}
+
+SKR_API void skr_cef_get_render_diag(SkrRenderDiag* out)
+{
+    if (!out) return;
+    memset(out, 0, sizeof(*out));
+
+    auto& rm = RenderManager::Instance();
+    out->has_device     = rm.GetDevice() != nullptr;
+    out->has_on_present = static_cast<bool>(rm.OnPresent);
+    out->force_draw     = runtime ? runtime->IsForceDrawEnabled() : false;
+
+    auto* bm = GetBrowser();
+    if (!bm) return;
+
+    out->draw_enabled = !bm->ShouldSkipBrowserRendering();
+    out->hwnd_found   = runtime && runtime->GetGta() && runtime->GetGta()->GetHwnd() != nullptr;
+
+    // Walk browsers
+    for (auto& [id, inst] : bm->GetBrowsersMap()) {
+        if (!inst) continue;
+        out->browser_count++;
+        if (inst->visible) {
+            out->visible_count++;
+            if (out->visible_count == 1) {
+                out->view_has_device  = inst->view.GetTexture() != nullptr || inst->view.HasDevice();
+                out->view_has_texture = inst->view.GetTexture() != nullptr;
+            }
+        }
+        if (bm->HasPendingPaint(id))
+            out->pending_count++;
+    }
+}
