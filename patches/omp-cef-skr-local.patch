+#pragma once
+// SKR Local Browser API — C exports for omp-cef client.dll
+// SKR.Client.dll resolves these via GetProcAddress to drive the lobby
+// browser independently of the SA-MP network layer.
+//
+// BUILD: core/CMakeLists.txt includes this file via CONFIGURE_DEPENDS glob.
+
+#include <cstdint>
+
+#ifdef SKR_LOCAL_API_EXPORTS
+#  define SKR_API extern "C" __declspec(dllexport)
+#else
+#  define SKR_API extern "C" __declspec(dllimport)
+#endif
+
+// Browser management
+SKR_API bool    skr_cef_ready();
+SKR_API void    skr_cef_create_browser(uint32_t id, const char* url, bool hidden, bool focused);
+SKR_API void    skr_cef_destroy_browser(uint32_t id);
+SKR_API void    skr_cef_hide_browser(uint32_t id, bool hide);
+SKR_API void    skr_cef_focus_browser(uint32_t id, bool focus);
+SKR_API bool    skr_cef_browser_exists(uint32_t id);
+SKR_API bool    skr_cef_browser_ready(uint32_t id);
+SKR_API bool    skr_cef_try_focus_browser(uint32_t id);
+SKR_API bool    skr_cef_input_available(uint32_t id);
+SKR_API bool    skr_cef_gta_window_active();
+// True when a visible browser other than `ownId` (e.g. a server's intro) has focus.
+SKR_API bool    skr_cef_foreign_browser_focused(uint32_t ownId);
+// True while server CEF resources are downloading.
+SKR_API bool    skr_cef_resources_pending();
+
+// Event system (local only — does not go through the network)
+SKR_API void    skr_cef_emit_event(const char* event, void* args);
+SKR_API void    skr_cef_subscribe(const char* event, void* callback);
+// Same as skr_cef_emit_event, but delivers `arg` (UTF-8, may be null) to the
+// JS cef.on() handler as its first string argument.
+SKR_API void    skr_cef_emit_event_str(const char* event, const char* arg);
+
+// Compatibility placeholder: returns nullptr. Local event payloads are UTF-8
+// strings, not samp-cef CefListValue instances.
+SKR_API void*   skr_cef_create_list();
+
+// Browser ready callback
+SKR_API void    skr_cef_on_browser_ready(uint32_t id, void* callback);
+
+// Render pipeline pump — called from SKR's EndScene hook when bootstrap
+// hooks failed. Feeds the D3D9 device to RenderManager and fires the
+// render tick so CEF browsers draw to the screen.
+SKR_API void    skr_cef_pump_render();
+
+// Force draw_enabled_ on regardless of window focus / menu state.
+// Call with true before lobby rendering; false when entering game.
+SKR_API void    skr_cef_set_force_draw(bool enabled);
+
+// Page zoom for a browser (1.0 = 100%), applied on the CEF UI thread.
+SKR_API void    skr_cef_set_zoom(uint32_t id, double factor);
+
+// Diagnostic: fill a fixed-size struct with render pipeline state.
+struct SkrRenderDiag {
+    bool has_device;
+    bool has_on_present;
+    bool draw_enabled;
+    bool force_draw;
+    int  browser_count;
+    int  visible_count;
+    int  pending_count;       // browsers with pending paint data
+    bool view_has_device;     // first visible browser's view
+    bool view_has_texture;    // first visible browser's view
+    bool hwnd_found;
+};
+SKR_API void    skr_cef_get_render_diag(SkrRenderDiag* out);
+
+#ifdef __cplusplus
+#include <string>
+// Internal (not exported): delivers a JS cef.emit() to SKR subscribers on the
+// GTA main thread. Only the registered local lobby main frame is accepted.
+// Returns false for an untrusted page or when nobody subscribed to `name`.
+// SKR callbacks receive `payload` (the first JS string argument, or nullptr)
+// as their `void* args` parameter, i.e. a NUL-terminated UTF-8 const char*.
+// Internal: resource download progress (DownloadDialog) for the SKR lobby.
+// state: "start" | "progress" | "done". Forwarded as "skr:lobby:connect:download".
+void SkrNotifyDownload(const char* state, uint64_t received, uint64_t total, size_t files);
+// Internal: true while the SKR lobby page exists (it shows download progress itself).
+bool SkrLobbyPageActive();
+bool SkrDispatchLocalEvent(int browserId, const std::string& frameUrl, const std::string& name, const std::string* payload);
+#endif
diff --git a/src/client/core/std_rotate_stub.cpp b/src/client/core/std_rotate_stub.cpp
new file mode 100644
index 0000000..6f39b9a
--- /dev/null
+++ b/src/client/core/std_rotate_stub.cpp
@@ -0,0 +1,28 @@
+// ABI compatibility stub: OpenAL (vcpkg) references __std_rotate from a newer
+// MSVC STL than the one shipping with this toolset. Provide a minimal byte-
+// level rotate so the linker is satisfied.
+// Symbol decoration ___std_rotate@12 → __stdcall, 3 pointer args (x86).
+
+#include <cstring>
+
+extern "C" void* __stdcall __std_rotate(void* _First, void* _Mid, void* _Last)
+{
+    auto* first = static_cast<unsigned char*>(_First);
+    auto* mid   = static_cast<unsigned char*>(_Mid);
+    auto* last  = static_cast<unsigned char*>(_Last);
+
+    if (first == mid)  return last;
+    if (mid   == last) return first;
+
+    auto* ret = first + (last - mid);
+
+    // Triple-reverse algorithm
+    auto reverse = [](unsigned char* a, unsigned char* b) {
+        while (a < --b) { unsigned char t = *a; *a++ = *b; *b = t; }
+    };
+    reverse(first, mid);
+    reverse(mid, last);
+    reverse(first, last);
+
+    return ret;
+}
