{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x86-debug",
      "displayName": "Win32 Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x86-release",
      "displayName": "Win32 Release",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "external-lobby-x86",
      "displayName": "External lobby Win32 Release (VS 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build-external-lobby",
      "cacheVariables": {
        "SKR_EXTERNAL_LOBBY": "ON"
      }
    },
    {
      "name": "op215-x86",
      "displayName": "OP215 Custom Vehicles (experimental, VS 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build-op215",
      "cacheVariables": {
        "SKR_EXTERNAL_LOBBY": "ON",
        "SKR_OP215": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "x86-debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "x86-release",
      "configuration": "Release"
    },
    {
      "name": "external-lobby",
      "configurePreset": "external-lobby-x86",
      "configuration": "Release",
      "targets": [
        "SKRLauncher",
        "SKRClient",
        "SKRLobbyTests",
        "SKRLaunchIpcTests"
      ]
    },
    {
      "name": "op215",
      "configurePreset": "op215-x86",
      "configuration": "Release",
      "targets": [
        "SKRLauncher",
        "SKRClient"
      ]
    }
  ]
}
